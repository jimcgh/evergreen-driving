	<main id="page-home">
		
		<section id="hero" class="relative bg-white overflow-hidden">
			<div class="absolute top-0 right-0 w-[50vw] h-full bg-indigo-50/50 rounded-bl-[100px] -z-10 hidden md:block"></div>
			<div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-12 px-6 pt-12 pb-24 md:pt-24 md:pb-32">
				<div class="w-full md:w-1/2 text-center md:text-left z-10">
					<div class="inline-flex items-center gap-2 bg-indigo-100 text-indigo-700 px-4 py-2 rounded-full text-sm font-bold mb-8 mx-auto md:mx-0">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/></svg>
						<span>ICBC 認證專業培訓</span>
					</div>
					<h1 class="text-5xl md:text-7xl font-black text-slate-900 leading-[1.05] mb-6 font-outfit uppercase">
						<span class="block text-xl md:text-3xl text-indigo-600 mb-4 tracking-wider">溫哥華考駕照首選</span>
						<span>自信掌握路況</span> <br><span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-blue-500">順利取得駕照</span>
					</h1>
					<p class="text-lg text-slate-700 mb-10 max-w-lg mx-auto md:mx-0 leading-relaxed">
						<span>跟隨經驗豐富的</span> <span class="font-bold text-slate-900">Evergreen 溫哥華中文駕駛教練。</span> <span>助您一次通過 ICBC 5/7級路考。</span>
					</p>
					<div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
						<a href="#contact" class="bg-indigo-600 hover:bg-indigo-700 text-white px-10 py-4 rounded-full font-bold text-lg transition-all shadow-xl shadow-indigo-200 flex items-center justify-center gap-2 hover:-translate-y-1 cursor-pointer">
							<span>開始學習</span> 
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
						</a>
						<a href="#prep" class="bg-white hover:bg-slate-50 border-2 border-slate-200 text-slate-700 px-10 py-4 rounded-full font-bold text-lg transition-all flex items-center justify-center gap-2 cursor-pointer">
							<span>ICBC 備考</span>
						</a>
					</div>
				</div>
				
				<div class="w-full md:w-1/2 relative px-6 md:px-0">
					<div class="absolute inset-0 bg-indigo-600 rounded-[3rem] rotate-3 scale-95 opacity-10"></div>
					
					<img src="/images/hero-desktop.webp" 
					srcset="/images/hero-mobile.webp 800w, /images/hero-desktop.webp 1200w"
					sizes="(max-width: 768px) 100vw, 50vw"
					fetchpriority="high"
					alt="Professional Driving Instruction" 
					class="relative w-full h-[400px] md:h-[600px] object-cover rounded-[3rem] shadow-2xl z-10"/>
					
					<div class="absolute bottom-10 left-0 md:-left-12 bg-white/95 backdrop-blur-md p-6 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.1)] animate-float border border-white flex items-center gap-5 z-20">
						<div class="w-16 h-16 bg-white p-1 rounded-2xl flex items-center justify-center border border-indigo-100 shadow-sm">
							<img src="data:image/svg+xml;base64," alt="Evergreen Icon" class="w-full h-full object-contain">
						</div>
						<div>
							<p class="font-black text-slate-900 text-2xl">98% 及格率</p>
							<p class="text-sm text-slate-500 font-bold tracking-wide uppercase mt-1">首次考試通過率</p>
						</div>
					</div>
				</div>
			</div>
		</section>
		
		<div class="bg-slate-900 py-5 border-y border-slate-800">
			<div class="max-w-7xl mx-auto px-6 flex flex-wrap justify-center md:justify-between items-center gap-6 text-slate-300 text-xs md:text-sm font-bold uppercase tracking-widest">
				<span class="flex items-center gap-2">
					<svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
					<span>ICBC 認證教練</span>
				</span>
				<span class="flex items-center gap-2">
					<svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
					<span>全額保險保障</span>
				</span>
				<span class="flex items-center gap-2">
					<svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
					<span>雙控安全車輛</span>
				</span>
				<span class="flex items-center gap-2 hidden lg:flex">
					<svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
					<span>五星學員評價</span>
				</span>
			</div>
		</div>
		
		<section class="py-24 bg-white border-b border-slate-100">
			<div class="max-w-7xl mx-auto px-6">
				<div class="text-center mb-16">
					<p class="text-indigo-600 font-bold uppercase tracking-widest text-sm mb-3">認識我們的團隊</p>
					<h2 class="text-4xl md:text-5xl font-black text-slate-900 font-outfit uppercase">
						您的本地駕駛 <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-blue-500">專家</span>
					</h2>
				</div>
				<div class="flex flex-col md:flex-row items-center gap-12 bg-slate-50 rounded-[3rem] p-8 md:p-12 border border-slate-100">
					<div class="w-32 h-32 md:w-48 md:h-48 flex-shrink-0 bg-indigo-100 rounded-full flex items-center justify-center overflow-hidden border-4 border-white shadow-xl">
						<img src="instructor-profile.webp" alt="Evergreen Driving Instructor" class="w-full h-full object-cover">
					</div>
					<div>
						<h3 class="text-3xl font-bold text-slate-900 mb-2">高素質的專業教練</h3>
						<p class="text-indigo-600 font-semibold mb-4">精通英語和粵語</p>
						<p class="text-slate-600 leading-relaxed max-w-2xl">
							我們的教練均獲得 ICBC 的正式認證。我們專注於幫助緊張的新手成為自信、具備防禦性駕駛能力的司機。憑藉多年在列治文和溫哥華考區的教學經驗，我們完全了解考官的評分標準。
						</p>
					</div>
				</div>
			</div>
		</section>
		
		<section id="features" class="py-24 bg-slate-50 scroll-mt-20">
			<div class="max-w-7xl mx-auto px-6">
				<div class="text-center mb-16">
					<p class="text-indigo-600 font-bold uppercase tracking-widest text-sm mb-3">Evergreen 的優勢</p>
					<h2 class="text-4xl md:text-5xl font-black text-slate-900 font-outfit uppercase">
						<span>為什麼選擇</span> <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-blue-500">Evergreen</span>
					</h2>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="bg-white p-10 rounded-[2rem] shadow-sm border border-slate-100 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
						<div class="w-16 h-16 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
						</div>
						<h3 class="text-2xl font-bold text-slate-900 mb-4">雙控安全系統</h3>
						<p class="text-slate-500 leading-relaxed">安全第一。所有教練車均經 ICBC 認證並配備教練副剎車。</p>
					</div>
					<div class="bg-white p-10 rounded-[2rem] shadow-sm border border-slate-100 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
						<div class="w-16 h-16 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
