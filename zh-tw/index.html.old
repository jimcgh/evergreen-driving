			.group:hover .group-hover\:scale-105 { scale: 1.05; } .group:hover .group-hover\:scale-110 { scale: 1.1; }
			.group:hover .group-hover\:bg-emerald-500 { background-color: var(--color-emerald-500); } .group:hover .group-hover\:bg-indigo-500 { background-color: var(--color-indigo-500); } .group:hover .group-hover\:bg-indigo-600 { background-color: var(--color-indigo-600); } .group:hover .group-hover\:bg-slate-200 { background-color: var(--color-slate-200); }
			.group:hover .group-hover\:text-white { color: var(--color-white); } .group:hover .group-hover\:text-indigo-600 { color: var(--color-indigo-600); } .group:hover .group-hover\:text-slate-900 { color: var(--color-slate-900); }
			.group:hover .group-hover\:rotate-180 { rotate: 180deg; }
			.group:hover .group-hover\:opacity-100 { opacity: 1; } .group:hover .group-hover\:visible { visibility: visible; } .group:hover .group-hover\:translate-y-0 { transform: translateY(0); }
			
			.hover\:-translate-y-1:hover { transform: translateY(-0.25rem); } .hover\:-translate-y-2:hover { transform: translateY(-0.5rem); }
			.hover\:bg-\[\#06ad56\]:hover { background-color: #06ad56; } .hover\:bg-indigo-50:hover { background-color: var(--color-indigo-50); } .hover\:bg-indigo-700:hover { background-color: var(--color-indigo-700); } .hover\:bg-slate-50:hover { background-color: var(--color-slate-50); } .hover\:bg-slate-100:hover { background-color: var(--color-slate-100); }
			.hover\:text-indigo-600:hover { color: var(--color-indigo-600); } .hover\:text-indigo-700:hover { color: var(--color-indigo-700); } .hover\:text-slate-900:hover { color: var(--color-slate-900); }
			.hover\:shadow-xl:hover { box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }
			
			.outline-none { outline: 2px solid transparent; outline-offset: 2px; }
			
			@media (min-width: 640px) {
				.sm\:flex-row { flex-direction: row; } .sm\:px-6 { padding-left: 1.5rem; padding-right: 1.5rem; }
			}
			@media (min-width: 768px) {
				.md\:-right-8 { right: -2rem; } .md\:-left-8 { left: -2rem; } .md\:-left-12 { left: -3rem; } .md\:mx-0 { margin-inline: 0; }
				.md\:block { display: block; } .md\:flex { display: flex; } .md\:hidden { display: none; }
				.md\:h-12 { height: 3rem; } .md\:h-\[600px\] { height: 600px; } .md\:w-1\/2 { width: 50%; }
				.md\:grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
				.md\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } .md\:grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
				.md\:flex-row { flex-direction: row; } .md\:justify-between { justify-content: space-between; } .md\:justify-start { justify-content: flex-start; }
				.md\:gap-6 { gap: 1.5rem; } .md\:gap-12 { gap: 3rem; } .md\:p-5 { padding: 1.25rem; } .md\:px-0 { padding-left: 0; padding-right: 0; }
				.md\:pt-24 { padding-top: 6rem; } .md\:pb-32 { padding-bottom: 8rem; }
				.md\:text-left { text-align: left; } .md\:text-2xl { font-size: 1.5rem; line-height: 2rem; } .md\:text-3xl { font-size: 1.875rem; line-height: 2.25rem; } .md\:text-5xl { font-size: 3rem; line-height: 1; } .md\:text-6xl { font-size: 3.75rem; line-height: 1; } .md\:text-7xl { font-size: 4.5rem; line-height: 1; } .md\:text-sm { font-size: 0.875rem; line-height: 1.25rem; } .md\:text-xl { font-size: 1.25rem; line-height: 1.75rem; }
			}
			@media (min-width: 1024px) {
				.lg\:flex { display: flex; } .lg\:w-1\/2 { width: 50%; } .lg\:flex-row { flex-direction: row; }
				.lg\:text-left { text-align: left; }
			}
		}
		
		/* --- CUSTOM STYLES --- */
		html { scroll-padding-top: 80px; }
		body { font-family: 'Plus Jakarta Sans', sans-serif; }
		.font-outfit { font-family: 'Outfit', sans-serif; }
		
		@keyframes float { 
			0% { transform: translateY(0px); } 
			50% { transform: translateY(-12px); } 
			100% { transform: translateY(0px); } 
		}
		.animate-float { animation: float 3.5s ease-in-out infinite; }
		
		@keyframes scroll { 
			0% { transform: translateX(0); } 
			100% { transform: translateX(-50%); } 
		}
		.marquee-wrapper { 
			display: flex; 
			width: max-content; 
			animation: scroll 40s linear infinite; 
		}
		.marquee-wrapper:hover { animation-play-state: paused; }
		
		.review-card { 
			width: 320px; flex-shrink: 0; background: white; border-radius: 1.5rem; padding: 1.5rem; 
			box-shadow: 0 10px 40px -10px rgb(0 0 0 / 0.08); border: 1px solid #f8fafc; margin-right: 1.5rem; 
			display: flex; flex-direction: column;			
		}
		
		/* Desktop Dropdown CSS */
		.dropdown-container { position: relative; height: 100%; display: flex; align-items: center; cursor: pointer; }
		.dropdown-menu {
			position: absolute;
			top: calc(100% - 5px);
			padding-top: 10px;
			opacity: 0;
			visibility: hidden;
			transform: translateY(10px);
			transition: all 0.2s ease-in-out;
			z-index: 100;
			pointer-events: none;
		}
		.dropdown-menu-left { left: 0; }
		.dropdown-menu-right { right: 0; }
		
		.dropdown-container:hover .dropdown-menu {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
			pointer-events: auto;
		}
		.dropdown-container:hover .nav-arrow { transform: rotate(180deg); }
		.dropdown-container:hover .nav-text { color: var(--color-indigo-600); }
		.lang-container:hover .lang-text { color: var(--color-slate-900); }
		.lang-container:hover .lang-btn { background-color: var(--color-slate-200); }
		
		.timeline-line::before {
			content: ''; position: absolute; top: 2rem; left: 10%; right: 10%; height: 3px; background: #e0e7ff; z-index: 0;
		}
		/* 當選單內部獲得鍵盤焦點時，強制展開下拉選單 */
		.dropdown-container:focus-within .dropdown-menu {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
			pointer-events: auto;
		}
		@media (max-width: 768px) { .timeline-line::before { display: none; } }
		
		/* Cookie Banner 定位與動畫樣式 */
		.cookie-banner-custom {
			position: fixed !important;
			bottom: 0 !important;
			left: 0 !important;
			right: 0 !important;
			transition: transform 0.3s ease-in-out !important;
		}
		.cookie-banner-hide {
			transform: translateY(100%) !important;
		}
	</style>
</head>
