	<div id="cookie-banner" role="region" aria-label="Cookie 同意聲明" class="hidden cookie-banner-custom cookie-banner-hide bg-slate-900 text-slate-100 p-4 z-50 shadow-2xl border-t border-slate-800">
		<div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
			<div class="text-sm text-slate-300">
				我們使用 Cookie 來優化您的瀏覽體驗，並透過 Google Analytics 分析網站流量。點擊「同意」即表示您接受我們使用 Cookie。閱讀我們的 <a href="privacy-tc.html" class="text-indigo-400 underline hover:text-indigo-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded">隱私權政策</a>。
			</div>
			<div class="flex items-center gap-3 shrink-0">
				<button id="btn-accept-cookie" class="bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold px-4 py-2 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 transition-colors">
					同意
				</button>
				<button id="btn-decline-cookie" class="text-slate-400 hover:text-slate-300 text-sm font-medium px-3 py-2 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 transition-colors">
					拒絕
				</button>
			</div>
		</div>
	</div>
	
	<script>
		function initializeEvergreenSchool() {
			// === 1. WeChat 彈窗控制 ===
			let lastActiveElement;
			
			window.openWechatModal = function() {
				lastActiveElement = document.activeElement;
				const modal = document.getElementById('wechat-modal');
				const content = document.getElementById('wechat-modal-content');
				if (modal && content) {
					modal.classList.remove('hidden');
					setTimeout(() => { 
						modal.classList.remove('opacity-0'); 
						content.classList.remove('scale-95'); 
						const closeBtn = document.getElementById('wechat-close-btn');
						if (closeBtn) closeBtn.focus();
					}, 10);
				}
			};
			
			window.closeWechatModal = function() {
				const modal = document.getElementById('wechat-modal');
				const content = document.getElementById('wechat-modal-content');
				if (modal && content) {
					modal.classList.add('opacity-0'); 
					content.classList.add('scale-95');
					setTimeout(() => { 
						modal.classList.add('hidden'); 
						if (lastActiveElement) lastActiveElement.focus();
					}, 300);
				}
			};
			
			document.addEventListener('keydown', (e) => {
				const modal = document.getElementById('wechat-modal');
				if (modal && e.key === 'Escape' && !modal.classList.contains('hidden')) {
					closeWechatModal();
				}
			});
			
			// === 2. 手機版選單控制 ===
			const menuBtn = document.getElementById('mobile-menu-btn');
			const menu = document.getElementById('mobile-menu');
			
			if (menuBtn && menu) {
				menuBtn.addEventListener('click', (e) => { 
					e.stopPropagation(); 
					menu.classList.toggle('hidden'); 
				});
				
				document.addEventListener('click', (e) => {
					if (!menu.contains(e.target) && !menuBtn.contains(e.target)) {
						menu.classList.add('hidden');
					}
				});
				
				const mobileLinks = menu.querySelectorAll('a');
				mobileLinks.forEach(link => {
					link.addEventListener('click', () => {
						menu.classList.add('hidden');
					});
				});
			}
			
			// === 3. 下拉選單 A11Y 鍵盤導航 ===
			const setupDropdownA11y = (containerId, buttonId) => {
				const container = document.querySelector(containerId);
				const button = document.getElementById(buttonId);
				if (container && button) {
					container.addEventListener('focusin', () => button.setAttribute('aria-expanded', 'true'));
					container.addEventListener('focusout', () => button.setAttribute('aria-expanded', 'false'));
				}
			};
			setupDropdownA11y('.dropdown-container', 'programs-btn');
			setupDropdownA11y('.lang-container', 'lang-btn');
			
			// === 4. 動態年份更新 ===
			const yearEl = document.getElementById('year');
			if (yearEl) {
				yearEl.innerText = "2019 - " + new Date().getFullYear();
			}
			
			// === 5. Cookie Consent Banner 控制 ===
			const cookieBanner = document.getElementById('cookie-banner');
			const btnAccept = document.getElementById('btn-accept-cookie');
			const btnDecline = document.getElementById('btn-decline-cookie');
			
			if (cookieBanner && btnAccept && btnDecline) {
				let cookieConsent = null;
				
				try {
					cookieConsent = localStorage.getItem('cookieConsent');
				} catch (e) {
					console.warn("LocalStorage blocked by browser security.", e);
				}
				
				if (!cookieConsent) {
					cookieBanner.classList.remove('hidden');
					cookieBanner.removeAttribute('hidden');
					setTimeout(() => {
						cookieBanner.classList.remove('cookie-banner-hide');
					}, 100);
				}
				
				btnAccept.addEventListener('click', function () {
					try {
						localStorage.setItem('cookieConsent', 'accepted');
					} catch (e) {}
					hideBanner();
				});
				
				btnDecline.addEventListener('click', function () {
					try {
						localStorage.setItem('cookieConsent', 'declined');
					} catch (e) {}
					hideBanner();
				});
				
				function hideBanner() {
					cookieBanner.classList.add('cookie-banner-hide');
					setTimeout(() => {
						cookieBanner.classList.add('hidden');
						cookieBanner.setAttribute('hidden', 'true');
					}, 300);
				}
			}
		}
		
		if (document.readyState === 'interactive' || document.readyState === 'complete') {
			initializeEvergreenSchool();
		} else {
			document.addEventListener('DOMContentLoaded', initializeEvergreenSchool);
		}
	</script>
</body>
