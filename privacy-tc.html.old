<!DOCTYPE html>
<html lang="zh-Hant" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Privacy Policy - Evergreen Driving School</title>
  <meta name="description" content="Privacy Policy for Evergreen Driving School. Learn how we collect, use, and protect your information in compliance with PIPEDA and Google Analytics.">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  
  <!-- 引入 Tailwind CSS (請依您現有項目的引入方式調整，此處使用 CDN 示意) -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- 配合 A11Y 的全域焦點樣式與微調 -->
  <style>
    /* 移除預設 outline，僅在鍵盤聚焦時顯示自訂焦點環 */
    *:focus {
      outline: none;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen">
  
  <!-- [A11Y] 跳過導航連結（讓螢幕閱讀器使用者直接跳到主要內容） -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-indigo-600 text-white px-4 py-2 rounded-lg z-50">
    Skip to content
  </a>
  
  <!-- 1. 導航欄 (Navbar) -->
  <!-- 請將此處替換為您 index.html 已優化的 Navbar 代碼，並注意將非首頁的連結（如 #contact）改為跨頁連結（如 index.html#contact） -->
  <!-- 1. 導航欄 (Navbar) - 繁中版 (支援電腦與手機) -->
  <header class="bg-white shadow-sm sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between relative">
      <a href="index-tc.html" class="text-xl font-bold text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded px-1">
        Evergreen 駕駛學校
      </a>
      
      <!-- 【電腦版選單】 -->
      <nav class="hidden md:flex items-center space-x-6">
        <a href="index-tc.html" class="text-slate-600 hover:text-slate-950 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded px-1">首頁</a>
        <a href="index-tc.html#contact" class="text-slate-600 hover:text-slate-950 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded px-1">聯絡我們</a>
        
        <div class="lang-container group relative inline-block text-left">
          <button id="lang-btn" aria-haspopup="true" aria-expanded="false" class="text-slate-600 hover:text-slate-950 flex items-center gap-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg px-2 py-1 transition-colors">
            語言
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          
          <div class="dropdown-menu absolute right-0 mt-2 w-32 bg-white border border-slate-200 rounded-lg shadow-lg py-1 hidden group-hover:block focus-within:block dropdown-container:focus-within before:block before:absolute before:-top-2 before:left-0 before:right-0 before:h-2">
            <a href="privacy.html" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 focus:outline-none focus:bg-slate-50">English</a>
            <a href="privacy-tc.html" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 focus:outline-none focus:bg-slate-50">繁體中文</a>
            <a href="privacy-sc.html" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 focus:outline-none focus:bg-slate-50">簡體中文</a>
          </div>
        </div>
      </nav>

      <!-- 【手機版漢堡選單按鈕】 -->
      <button id="mobile-menu-btn" class="md:hidden text-slate-600 hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded p-1" aria-label="切換選單">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

      <!-- 【手機版選單下拉區】 -->
      <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 right-0 bg-white border-b border-slate-200 shadow-lg z-30">
        <div class="px-6 py-4 flex flex-col space-y-4">
          <a href="index-tc.html" class="text-slate-600 hover:text-slate-950 font-medium">首頁</a>
          <a href="index-tc.html#contact" class="text-slate-600 hover:text-slate-950 font-medium">聯絡我們</a>
          
          <div class="border-t border-slate-100 pt-4 flex flex-col space-y-2">
