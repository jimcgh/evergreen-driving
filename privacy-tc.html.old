            <a href="privacy.html" class="text-slate-600 hover:text-slate-950 font-medium pl-2">English</a>
            <a href="privacy-tc.html" class="text-slate-600 hover:text-slate-950 font-medium pl-2">繁體中文</a>
            <a href="privacy-sc.html" class="text-slate-600 hover:text-slate-950 font-medium pl-2">簡體中文</a>
          </div>
